[Compositing]
OpenGLIsUnsafe=false

[Plugins]
blurEnabled=true
fadingpopupsEnabled=false
dialogparentEnabled=true

fadeEnabled=false
scaleEnabled=false

squashEnabled=false
translucencyEnabled=false
magiclampEnabled=false

lingmo_scaleEnabled=true
linglauncherEnabled=true


[Effect-Blur]
BlurStrength=15
NoiseStrength=0

[Windows]
FocusStealingPreventionLevel=0
HideUtilityWindowsForInactive=false
BorderlessMaximizedWindows=false
Placement=Centered

[Effect-FlipSwitch]
TabBox=false
TabBoxAlternative=false

[Effect-CoverSwitch]
TabBox=false
TabBoxAlternative=false

[Effect-SlidingPopups]
SlideInTime=250
SlideOutTime=250

[TabBox]
ActivitiesMode=1
ApplicationsMode=0
BorderActivate=9
BorderAlternativeActivate=9
DesktopMode=1
HighlightWindows=true
LayoutName=lingmo_carousel
MinimizedMode=0
MultiScreenMode=0
ShowDesktopMode=0
ShowTabBox=true
SwitchingMode=0

# Hot corners (Settings > Effects). Corners are KWin ElectricBorder numbers:
# 1 top right, 3 bottom right, 5 bottom left, 7 top left, 9 none.
[ElectricBorders]
TopLeft=None
TopRight=None
BottomRight=None
BottomLeft=None

[Effect-overview]
BorderActivate=7

[Effect-windowview]
BorderActivate=9
BorderActivateAll=9

# Launcher and lock screen corners: scripts/linghotcorners
[Script-linghotcorners]
Launcher=9
LockScreen=9

[TouchEdges]
Bottom=None
Left=None
Right=None
Top=None

# KWin 6.3+ reads the decoration plugin from kdecoration3 but the button layout
# and border size from kdecoration2: keep both. XIA = close, minimize, maximize
# on the left, macOS order.
[org.kde.kdecoration2]
BorderSize=Normal
ButtonsOnLeft=XIA
ButtonsOnRight=

[org.kde.kdecoration3]
BorderSize=Normal
ButtonsOnLeft=XIA
ButtonsOnRight=
library=org.lingmo.decoration
theme=
